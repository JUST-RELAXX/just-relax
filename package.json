{
  "name": "aurora-player",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/desktop",
    "packages/schema",
    "packages/lyrics",
    "spikes"
  ],
  "scripts": {
    "dev": "npm run dev --workspace @aurora/desktop",
    "build": "npm run build --workspace @aurora/desktop",
    "dist": "npm run dist --workspace @aurora/desktop",
    "package:dir": "npm run package:dir --workspace @aurora/desktop",
    "typecheck": "npm run typecheck --workspace @aurora/desktop && npm run typecheck --workspace @aurora/lyrics && npm run typecheck --workspace @aurora/schema && npm run typecheck --workspace @aurora/spikes",
    "licenses": "node scripts/generate-third-party-notices.mjs",
    "lint": "eslint .",
    "format": "prettier --write \"apps/**/*.{ts,tsx,css,html,json}\" \"packages/**/*.{ts,json}\" \"spikes/**/*.{ts,html,css,json}\" \"scripts/**/*.{mjs,js,json}\" \"*.{json,js}\" \"docs/*.md\" README.md",
    "format:check": "prettier --check \"apps/**/*.{ts,tsx,css,html,json}\" \"packages/**/*.{ts,json}\" \"spikes/**/*.{ts,html,css,json}\" \"scripts/**/*.{mjs,js,json}\" \"*.{json,js}\" \"docs/*.md\" README.md",
    "test": "vitest run --pool=threads --maxWorkers=1 --no-file-parallelism",
    "spikes": "npm run dev --workspace @aurora/spikes"
  },
  "devDependencies": {
    "@types/node": "26.6.4",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@typescript-eslint/eslint-plugin": "8.71.0",
    "@typescript-eslint/parser": "8.71.0",
    "@vitejs/plugin-react": "5.2.0",
    "electron": "44.5.1",
    "electron-builder": "26.15.3",
    "electron-vite": "5.0.0",
    "eslint": "10.11.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.7",
    "prettier": "3.9.9",
    "typescript": "6.0.3",
    "vite": "7.3.6",
    "vitest": "5.0.3"
  },
  "dependencies": {
    "lucide-react": "1.49.0",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  }
}
